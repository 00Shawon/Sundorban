  "oral_histories": [
    {
      "id": "chanda",
      "person": "Chanda Ray",
      "person_bn": "চন্দা রায়",
      "occupation": "Housewife & Water Harvester",
      "occupation_bn": "গৃহিণী ও পানি সংগ্রাহক",
      "age": 42,
      "location": "Dacope, Khulna",
      "location_bn": "দাকোপ, খুলনা",
      "quote": "The taste of salt is everywhere—in our tea, in our rice, even in our tears. We walk for hours under a sun that feels like fire, searching for drinkable water that won't make our children sick.",
      "quote_bn": "লবণের স্বাদ সর্বত্র—আমাদের চায়ে, ভাতে, এমনকি চোখের জলেও। আগুনের মতো রোদে আমরা ঘণ্টার পর ঘণ্টা হেঁটে যাই এমন এক কলস খাবার পানির খোঁজে, যা পান করলে আমাদের শিশুরা অসুস্থ হবে না।",
      "audio_length": "2:14",
      "tag_en": "Salinity & Caregiving Crisis",
      "tag_bn": "লবণাক্ততা ও জীবনসংগ্রাম",
      "context": "In Dacope, women walk up to 6 kilometers daily carrying 15-liter metal pitchers (kolshi). Saline groundwater has induced widespread hypertension, maternal complications, and kidney ailments.",
      "context_bn": "দাকোপে নারীরা প্রতিদিন ১৫ লিটারের ভারী কলসি কাঁখে নিয়ে ৫-৬ কিলোমিটার পথ হাঁটেন। লবণাক্ত পানির কারণে স্থানীয়দের মধ্যে উচ্চ রক্তচাপ, গর্ভকালীন জটিলতা ও কিডনি রোগ মহামারি আকার ধারণ করেছে।"
    },
    {
      "id": "rahim",
      "person": "Rahim Molla",
      "person_bn": "রহিম মোল্লা",
      "occupation": "Former Honey Hunter (Mawali) & Displaced Day Laborer",
      "occupation_bn": "সাবেক মৌয়াল ও দিনমজুর",
      "age": 54,
      "location": "Gabura / Now Khulna Slum",
      "location_bn": "গাবুরা / বর্তমানে খুলনা বস্তি",
      "quote": "The forest was our mother. It gave us honey and fish. But when the Kholpetua swallowed my homestead in 2018, no bank gave us a loan. I am now pulling a rickshaw in Khulna, breathing exhaust fumes instead of salty mangroves.",
      "quote_bn": "সুন্দরবন ছিল আমাদের মায়ের মতো। মধু আর মাছ দিয়ে আমাদের বাঁচিয়ে রাখত। কিন্তু ২০১৮ সালে যখন খোলপেটুয়া নদী আমার ভিটেমাটি গিলে খেল, কোনো ব্যাংক ঋণ দেয়নি। আজ আমি খুলনার বস্তিতে রিকশা চালাই, বনের বাতাসের বদলে কালো ধোঁয়া নিই।",
      "audio_length": "1:48",
      "tag_en": "Ecological Eviction & Migration",
      "tag_bn": "পরিবেশগত উচ্ছেদ ও জলবায়ু শরণার্থী",
      "context": "Traditional livelihoods in Gabura collapsed after supercyclones disrupted mangrove fish nurseries and saline water killed agricultural land, triggering mass migration to Khulna and Dhaka.",
      "context_bn": "ঘূর্ণিঝড় ও লবণাক্ততার কারণে সুন্দরবনের ঐতিহ্যবাহী পেশা বিলুপ্ত হয়েছে। ফলে হাজার হাজার পরিবার পৈতৃক ভিটা ছেড়ে শহুরে বস্তিগুলোতে মানবেতর জীবনযাপন করতে বাধ্য হচ্ছে।"
    },
    {
      "id": "anwara",
      "person": "Anwara Begum",
      "person_bn": "আনোয়ারা বেগম",
      "occupation": "Primary School Teacher",
      "occupation_bn": "প্রাথমিক বিদ্যালয়ের শিক্ষিকা",
      "age": 36,
      "location": "Padmapukur, Satkhira",
      "location_bn": "পদ্মপুকুর, সাতক্ষীরা",
      "quote": "Three times our school building had to be dismantled and relocated inland. The children lose months of education every monsoon when our classrooms turn into emergency flood shelters.",
      "quote_bn": "তিনবার আমাদের স্কুল ভেঙে ভেতরে সরিয়ে নিতে হয়েছে। প্রতি বর্ষায় যখন শ্রেণিকক্ষগুলো সাইক্লোন আশ্রয়কেন্দ্রে পরিণত হয়, তখন শিশুদের লেখাপড়া মাসের পর মাস বন্ধ থাকে।",
      "audio_length": "2:30",
      "tag_en": "Disrupted Generations",
      "tag_bn": "শিক্ষা ও ভবিষ্যৎ বিপন্ন",
      "context": "Over 40% of schools in coastal delta zones double as cyclone shelters. Chronic flooding and erosion consistently elevate student dropout rates and early child marriage.",
      "context_bn": "উপকূলীয় অঞ্চলের ৪০% বিদ্যালয় সাইক্লোন শেল্টার হিসেবে ব্যবহৃত হয়। বারবার দুর্যোগের ফলে শিক্ষার্থীদের ঝরে পড়ার হার এবং বাল্যবিয়ে আশঙ্কাজনকভাবে বাড়ছে।"
    },
    {
      "id": "subal",
      "person": "Subal Das",
      "person_bn": "সুবল দাস",
      "occupation": "Shrimp Gher Worker & Fisher",
      "occupation_bn": "চিংড়ি ঘেরের শ্রমিক ও জেলে",
      "age": 29,
      "location": "Munshiganj, Satkhira",
      "location_bn": "মুন্সীগঞ্জ, সাতক্ষীরা",
      "quote": "People think shrimp farming made our region rich. It made five businessmen rich and turned the rest of us into landless laborers. Now even the shrimp die because river temperatures are rising.",
      "quote_bn": "মানুষ ভাবে চিংড়ি চাষে আমাদের অঞ্চল ধনী হয়েছে। আসলে ধনী হয়েছে মাত্র পাঁচজন ব্যবসায়ী, আর বাকি আমরা সবাই ভূমিহীন শ্রমিক হয়ে গেছি। এখন তো অতিরিক্ত তাপদাহে ঘেরের চিংড়িও মরে ভেসে উঠছে।",
      "audio_length": "1:55",
      "tag_en": "Debt Cycles & Economic Vulnerability",
      "tag_bn": "ঋণের চক্র ও অর্থনৈতিক বিপর্যয়",
      "context": "Commercial shrimp farming deliberately brought saline water inland through broken embankments during the 1990s, accelerating soil infertility and food insecurity.",
      "context_bn": "বাণিজ্যিক চিংড়ি চাষের জন্য নব্বইয়ের দশকে বাঁধ কেটে লবণাক্ত পানি ঢোকানো হয়েছিল। এর ফলশ্রুতিতে কৃষি জমি স্থায়ীভাবে নষ্ট হয়ে খাদ্য নিরাপত্তা ধ্বংস হয়েছে।"
    }
  ],
